{
  "name": "utb-external-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run copy:fixtures",
    "copy:fixtures": "node -e \"const fs=require('fs');fs.mkdirSync('dist/fixtures',{recursive:true});fs.copyFileSync('src/fixtures/seed.json','dist/fixtures/seed.json');fs.copyFileSync('src/fixtures/badges.json','dist/fixtures/badges.json');console.log('fixtures copied')\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
