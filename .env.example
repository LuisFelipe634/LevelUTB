DATABASE_URL="postgresql://postgres:postgres@localhost:5432/levelutb?schema=public"
# Credenciales del servicio db de docker-compose. docker-compose.yml las lee de
# aca (env_file + interpolacion), nunca las escribe como literal.
# OJO: POSTGRES_PASSWORD solo se aplica al inicializar un volumen pgdata VACIO.
# Si ya inicializaste con otra clave, o borra el volumen (docker compose down -v)
# o deja esta igual a la que usaste la primera vez.
POSTGRES_DB="levelutb"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="pon-aqui-tu-clave-local"
NEXTAUTH_SECRET="cambia-este-secreto-por-uno-seguro-de-32-caracteres-minimo"
NEXTAUTH_URL="http://localhost:3000"
# Registro con correo institucional (OTP). Elige uno:
# RESEND_API_KEY="re_xxx"            # Prod recomendado sin SMTP propio
# SMTP_HOST="smtp.utb.edu.co"        # SMTP institucional (integración nodemailer)
# SMTP_PORT="587"
# SMTP_USER="no-reply@utb.edu.co"
# SMTP_PASS="***"
EMAIL_FROM="LevelUTB <no-reply@utb.edu.co>"
# Bootstrap admin inicial (email que podrá crear docentes vía /api/admin/teachers)
ADMIN_EMAIL="admin@utb.edu.co"
# API académica externa (mock Docker / futura API universidad)
# Si UNIVERSITY_API_ENABLED=true, curriculum y student leen de UNIVERSITY_API_URL en vez de Prisma directo
# La BD host NO se borra: Docker usa volume pgdata separado y DATABASE_URL distinto (@db vs localhost)
UNIVERSITY_API_URL="http://localhost:3001"
UNIVERSITY_API_KEY="dev-key"
UNIVERSITY_API_ENABLED="true"
# En Docker compose, UNIVERSITY_API_URL se inyecta como http://external-academic-api:3001 automáticamente