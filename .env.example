# =======================================================
# LevelUTB - Plantilla de configuracion local
#
# INSTALACION RAPIDA (recomendada):
#   1. cp .env.example .env   (o deja que ./setup.sh lo haga solo)
#   2. ./setup.sh             (genera los secretos y levanta todo con Docker)
# No necesitas editar nada a mano: setup.sh genera NEXTAUTH_SECRET
# y POSTGRES_PASSWORD automaticamente si los deja como placeholder.
#
# SOLO edita este archivo a mano si NO usas ./setup.sh.
# =======================================================

# ---------- 1. Base de datos ----------
# URL que usa la app cuando corre en tu maquina (modo --local).
# En Docker se ignora: el servicio "app" la reescribe a @db automaticamente.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/levelutb?schema=public"

# Credenciales del servicio "db" de docker-compose.yml.
# docker-compose las lee desde tu .env (env_file + interpolacion).
POSTGRES_DB="levelutb"
POSTGRES_USER="postgres"
# OJO: solo se aplica al crear el volumen pgdata VACIO.
# Si ya levantaste antes con otra clave, conserva la misma o borra datos con:
#   docker compose down -v   (o ./setup.sh --reset --yes)
POSTGRES_PASSWORD="pon-aqui-tu-clave-local"

# ---------- 2. Autenticacion (NextAuth) ----------
# setup.sh lo genera solo (64 caracteres hex). No lo edites si usas setup.sh.
# Si lo pones a mano, usa minimo 32 caracteres aleatorios.
NEXTAUTH_SECRET="cambia-este-secreto-por-uno-seguro-de-32-caracteres-minimo"
# URL publica de la app. En Docker compose se fija a http://localhost:3000.
NEXTAUTH_URL="http://localhost:3000"

# ---------- 3. API academica externa (mock UTB) ----------
# Malla, cursos e insignias se leen siempre de aqui (no de Prisma directo).
# En tu maquina apunta a localhost; dentro de Docker compose se reescribe
# a http://external-academic-api:3001 automaticamente.
UNIVERSITY_API_URL="http://localhost:3001"
# Debe coincidir con el API_KEY que espera utb-external-api (ver su .env.example).
UNIVERSITY_API_KEY="dev-key"

# ---------- 4. Opcional ----------
# Seed condicional del contenedor "app": siembra demo solo si la tabla users
# esta vacia. Para desactivarlo en un entorno con datos reales:
# SEED_IF_EMPTY="false"
