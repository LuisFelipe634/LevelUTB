// ============================================
// UTB Gamificación - Schema de Base de Datos
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// MODELOS DE USUARIO Y AUTENTICACIÓN
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          UserRole  @default(STUDENT)
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relaciones
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  points         Point[]
  missions       StudentMission[]
  badges         StudentBadge[]
  notifications  Notification[]
  activities     Activity[]
  rewards        StudentReward[]

  @@map("users")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

// ============================================
// PERFILES POR ROL
// ============================================

model StudentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  studentCode     String   @unique  // Código universitario
  programId       String
  currentSemester Int      @default(1)
  admissionYear   Int
  totalCredits    Int      @default(0)
  averageGrade    Float    @default(0.0)
  level           Int      @default(1)  // Nivel académico actual

  // Relaciones
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program         Program  @relation(fields: [programId], references: [id])
  enrollments     Enrollment[]
  academicHistory AcademicRecord[]
  recommendations Recommendation[]
  riskAlerts      RiskAlert[]

  @@map("student_profiles")
}

model TeacherProfile {
  id         String  @id @default(cuid())
  userId     String  @unique
  department String?
  faculty    String?
  profession String?
  title      String?
  isActive   Boolean @default(true)

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedCourses TeacherCourse[]

  @@map("teacher_profiles")
}

// ============================================
// MODELOS ACADÉMICOS (MALLA CURRICULAR)
// ============================================

model Program {
  id          String   @id @default(cuid())
  code        String   @unique  // Ej: ISCO, IINF
  name        String
  totalCredits Int
  totalSemesters Int
  version     String   // Versión del plan de estudios
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Relaciones
  courses     Course[]
  students    StudentProfile[]
  semesters   Semester[]
  allowedStudents AllowedStudent[]

  @@map("programs")
}

model Semester {
  id          String  @id @default(cuid())
  programId   String
  number      Int     // Número del semestre (1-10)
  name        String? // Nombre opcional del semestre

  program     Program @relation(fields: [programId], references: [id])
  courses     Course[]

  @@unique([programId, number])
  @@map("semesters")
}

model Course {
  id              String   @id @default(cuid())
  code            String   @unique  // Ej: MAT101, PROG101
  name            String
  credits         Int
  programId       String
  semesterId      String
  type            CourseType @default(OBLIGATORIO)
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  // Relaciones
  program         Program  @relation(fields: [programId], references: [id])
  semester        Semester @relation(fields: [semesterId], references: [id])
  prerequisites   Prerequisite[] @relation("CoursePrerequisites")
  requiredBy      Prerequisite[] @relation("RequiredForCourse")
  enrollments     Enrollment[]
  studentRewards  StudentReward[] // Inverse Course relation for reward requests
  missions        Mission[]
  assignedTeachers TeacherCourse[]

  @@map("courses")
}

model TeacherCourse {
  id        String   @id @default(cuid())
  teacherId String
  courseId  String
  period    String
  createdAt DateTime @default(now())

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([teacherId, courseId, period])
  @@map("teacher_courses")
}

enum CourseType {
  OBLIGATORIO
  ELECTIVA
  LIBRE_ELECCION
  GENERAL
}

model Prerequisite {
  id            String  @id @default(cuid())
  courseId       String  // Curso que requiere el prerrequisito
  prerequisiteId String // Curso prerrequisito
  type          PrerequisiteType @default(REQUIRED)

  course        Course @relation("CoursePrerequisites", fields: [courseId], references: [id])
  prerequisite  Course @relation("RequiredForCourse", fields: [prerequisiteId], references: [id])

  @@unique([courseId, prerequisiteId])
  @@map("prerequisites")
}

enum PrerequisiteType {
  REQUIRED    // Prerrequisito obligatorio
  COREQUISITE // Correquisito (se puede ver en paralelo)
}

// ============================================
// MODELOS DE PROGRESO ESTUDIANTIL
// ============================================

model Enrollment {
  id          String         @id @default(cuid())
  studentId   String
  courseId     String
  semesterCode String        // Código del periodo (ej: 2024-1)
  status      EnrollmentStatus @default(INSCRITO)
  grade       Float?
  statusDetail String?       // Detalle del estado (APROBADO, REPROBADO, etc.)
  source      EnrollmentSource @default(UNIVERSITY)

  student     StudentProfile @relation(fields: [studentId], references: [id])
  course      Course         @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId, semesterCode])
  @@map("enrollments")
}

enum EnrollmentSource {
  UNIVERSITY
  MANUAL
}

enum EnrollmentStatus {
  INSCRITO
  CURSANDO
  APROBADO
  REPROBADO
  RETIRADO
  CANCELADO
}

model AcademicRecord {
  id          String         @id @default(cuid())
  studentId   String
  courseCode   String
  courseName   String
  grade       Float
  semester    Int
  year        Int
  status      AcademicStatus
  credits     Int
  importedAt  DateTime @default(now())

  student     StudentProfile @relation(fields: [studentId], references: [id])

  @@map("academic_records")
}

enum AcademicStatus {
  APROBADO
  REPROBADO
  EN_CURSO
  PENDIENTE
}

// ============================================
// MODELOS DE GAMIFICACIÓN
// ============================================

model Point {
  id          String    @id @default(cuid())
  userId      String
  amount      Int
  source      PointSource
  description String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])

  @@map("points")
}

enum PointSource {
  MISION_COMPLETADA
  RENDIMIENTO_ACADEMICO
  MEJORA_PROMEDIO
  CONSISTENCIA
  IMPACTO_SOCIAL
  EVENTO_ESPECIAL
  CANJE_RECOMPENSA
}

model Mission {
  id            String       @id @default(cuid())
  title         String
  description   String
  type          MissionType
  pointsReward  Int
  autoVerify    Boolean      @default(false)
  verificationKey String?    // Clave de la regla de verificación automática (ej. APROBAR_CREDITOS_SEMESTRE)
  verificationValue String?  // Parámetro de la regla (créditos, mejora de promedio, código de curso...)
  courseId       String?
  requiredLevel Int?         // Nivel mínimo requerido
  isActive      Boolean      @default(true)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime     @default(now())

  course        Course?      @relation(fields: [courseId], references: [id])
  students      StudentMission[]

  @@map("missions")
}

enum MissionType {
  ACADEMICO
  PLANIFICACION
  MEJORA_CONTINUA
  IMPACTO_SOCIAL
  HABITO_ESTUDIO
}

model StudentMission {
  id          String       @id @default(cuid())
  studentId   String
  missionId   String
  status      MissionStatus @default(PENDIENTE)
  progress    Int          @default(0)  // 0-100
  completedAt DateTime?
  evidence    String?      // URL o descripción de evidencia
  metadata    String?      // Datos de respaldo para verificación automática (JSON, ej. promedio inicial)
  verifiedBy  String?
  verifiedAt  DateTime?
  reviewComment String?
  createdAt   DateTime     @default(now())

  student     User         @relation(fields: [studentId], references: [id])
  mission     Mission      @relation(fields: [missionId], references: [id])

  @@unique([studentId, missionId])
  @@map("student_missions")
}

enum MissionStatus {
  PENDIENTE
  EN_PROGRESO
  EN_REVISION
  COMPLETADA
  VERIFICADA
  RECHAZADA
}

model Badge {
  id            String    @id @default(cuid())
  name          String
  description   String
  iconUrl       String
  category      BadgeCategory
  requiredLevel Int?
  pointsRequired Int?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  students      StudentBadge[]

  @@map("badges")
}

enum BadgeCategory {
  PROGRESO
  COMPETENCIA
  HABITO
  IMPACTO_SOCIAL
  RENDIMIENTO
}

model StudentBadge {
  id          String    @id @default(cuid())
  studentId   String
  badgeId     String
  earnedAt    DateTime  @default(now())
  evidence    String?
  verifiedBy  String?   // ID del verificador

  user        User      @relation(fields: [studentId], references: [id])
  badge       Badge     @relation(fields: [badgeId], references: [id])

  @@unique([studentId, badgeId])
  @@map("student_badges")
}

model Level {
  id          String @id @default(cuid())
  number      Int    @unique
  name        String
  minPoints   Int
  description String?
  iconUrl     String?

  @@map("levels")
}

// ============================================
// MODELOS DE NOTIFICACIONES Y ACTIVIDADES
// ============================================

model Notification {
  id          String    @id @default(cuid())
  userId      String
  title       String
  message     String
  type        NotificationType
  isRead      Boolean   @default(false)
  link        String?   // Enlace a la acción relevante
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])

  @@map("notifications")
}

enum NotificationType {
  INFO
  WARNING
  ALERTA_RIESGO
  LOGRO_OBTENIDO
  MISION_DISPONIBLE
  RECORDATORIO
  SOLICITUD_RECOMPENSA
}

model Activity {
  id          String    @id @default(cuid())
  userId      String
  action      String
  details     Json?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])

  @@map("activities")
}

// ============================================
// MODELO DE RECOMENDACIONES
// ============================================

model Recommendation {
  id          String    @id @default(cuid())
  studentId   String
  type        RecommendationType
  title       String
  description String
  priority    Int       @default(1)  // 1=alta, 2=media, 3=baja
  isRead      Boolean   @default(false)
  isAccepted  Boolean?
  createdAt   DateTime  @default(now())

  student     StudentProfile @relation(fields: [studentId], references: [id])

  @@map("recommendations")
}

enum RecommendationType {
  CURSO_SUGERIDO
  RUTA_ACademica
  ALERTA_ATRASO
  MEJORA_PROMEDIO
  ELECTIVA_RECOMENDADA
  RELLENAR_CREDITOS
}

// ============================================
// MODELO DE ALERTAS DE RIESGO
// ============================================

model RiskAlert {
  id          String    @id @default(cuid())
  studentId   String
  type        RiskAlertType
  severity    RiskSeverity
  title       String
  description String
  courseId     String?   // Curso relacionado si aplica
  isResolved  Boolean   @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("risk_alerts")
}

enum RiskAlertType {
  PREREQUISITO_FALTANTE
  ATRASO_CREDITOS
  BAJO_PROMEDIO
  CURSO_EN_RIESGO
  SEMESTRE_RETRASADO
}

enum RiskSeverity {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

// ============================================
// MODELOS DE RECOMPENSAS / BONIFICACIONES
// ============================================

model Reward {
  id          String        @id @default(cuid())
  name        String
  description String
  icon        String
  category    RewardCategory
  cost        Int           // Costo en puntos
  isActive    Boolean       @default(true)
  maxUses     Int?          // Límite de usos por estudiante (null = ilimitado)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  students    StudentReward[]

  @@map("rewards")
}

enum RewardCategory {
  EXAMEN        // Exonerar examen, mejorar nota
  ASISTENCIA    // Limpiar inasistencia
  ENTREGA       // Extender entrega, reintentar trabajo
  OTRO
}

model StudentReward {
  id          String         @id @default(cuid())
  studentId   String
  rewardId    String
  courseId    String
  status      RewardStatus   @default(SOLICITADO)
  pointsSpent Int            // Puntos gastados al momento de canjear
  requestedAt DateTime       @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  reviewNote  String?
  evidence    String?        // Evidencia adjunta (ej: captura de examen)
  expiresAt   DateTime?      // Fecha de expiración de la bonificación

  student     User           @relation(fields: [studentId], references: [id])
  reward      Reward         @relation(fields: [rewardId], references: [id])
  course      Course         @relation(fields: [courseId], references: [id])

  @@unique([studentId, rewardId, courseId])
  @@map("student_rewards")
}

enum RewardStatus {
  SOLICITADO   // Pendiente de revisión docente
  APROBADO     // Aprobado, bonificación activa
  RECHAZADO    // Rechazado por docente
  EXPIRADO     // Se venció el tiempo de uso
  USADO        // La bonificación fue aplicada
}

// ============================================
// REGISTRO CON CORREO INSTITUCIONAL (FASE 1)
// El email @utb.edu.co es la llave canónica:
// prueba de posesión vía OTP + aprovisionamiento JIT.
// ============================================

model EmailVerificationToken {
  id         String    @id @default(cuid())
  email      String
  codeHash   String    @unique // SHA-256 del OTP de 6 dígitos
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@map("email_verification_tokens")
}

model AllowedStudent {
  id            String   @id @default(cuid())
  email         String   @unique // email institucional normalizado (lowercase)
  studentCode   String   @unique // código universitario (ej. 2019123456)
  programId     String
  admissionYear Int
  fullName      String?
  createdAt     DateTime @default(now())

  program Program @relation(fields: [programId], references: [id])

  @@index([programId])
  @@map("allowed_students")
}
